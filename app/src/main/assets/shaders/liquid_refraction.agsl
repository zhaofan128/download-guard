// 液态玻璃边缘折射着色器（AGSL，API 33+）
// 在圆角边缘生成青紫分离的折射光带，模拟玻璃棱边对光线的弯折。
// 为避免全屏离屏渲染，本实现不采样背后内容，而是按到边缘的距离生成位移感光带；
// 强度 uStrength 控制光带宽度（视觉上不超过 4px 的偏移量级），并做轻微 RGB 色散。
uniform float2 uSize;
uniform float uCorner;
uniform float uStrength;

half4 main(float2 coord) {
    float2 halfSize = uSize * 0.5;
    float2 p = coord - halfSize;
    float edgeX = halfSize.x - abs(p.x);
    float edgeY = halfSize.y - abs(p.y);
    float edge = min(edgeX, edgeY);

    float band = max(uCorner * 0.55, 6.0) + uStrength * 2.0;
    float outer = 1.0 - smoothstep(0.0, band, edge);
    float inner = 1.0 - smoothstep(0.0, band * 0.35, edge);

    // 沿对角方向做极轻的色散过渡：左上偏青，右下偏紫
    float diag = clamp((p.x + p.y) / max(uSize.x + uSize.y, 1.0) + 0.5, 0.0, 1.0);
    half3 cool = half3(0.369, 0.918, 0.831);   // #5EEAD4
    half3 warm = half3(0.655, 0.545, 0.980);   // #A78BFA
    half3 color = mix(cool, warm, diag);

    // 色散：边缘中段让红/蓝通道轻微分离
    float fringe = smoothstep(0.0, band * 0.6, edge) * (1.0 - smoothstep(band * 0.6, band, edge));
    color.r = color.r + half(fringe * 0.10);
    color.b = color.b + half(fringe * 0.12);

    float alpha = outer * 0.16 + inner * 0.10;
    alpha = alpha + (1.0 - smoothstep(0.0, 1.5, edge)) * 0.20;
    return half4(color, half(clamp(alpha, 0.0, 0.42)));
}
