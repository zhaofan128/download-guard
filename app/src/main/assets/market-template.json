{
  "schema": 1,
  "name": "DownloadGuard 插件市场",
  "updatedAt": "2026-11-15",
  "plugins": [
    {
      "id": "community.example-sniffer",
      "name": "示例：站点直链嗅探",
      "version": "1.0.0",
      "author": "你的名字",
      "description": "把这段描述换成插件真实用途。示例展示了一个插件在市场里可以声明的全部字段：图标、仓库、更新日志、权限与可配置参数。",
      "category": "链接解析",
      "icon": "🔍",
      "repo": "your-name/your-plugin-repo",
      "homepage": "https://github.com/your-name/your-plugin-repo",
      "downloadUrl": "https://github.com/your-name/your-plugin-repo/archive/refs/heads/main.zip",
      "changelog": "1.0.0\n· 首个版本\n· 支持 xxx 站点",
      "permissions": ["network", "clipboard"],
      "enabledByDefault": false,
      "config": [
        {
          "key": "autoCopy",
          "label": "识别后自动填入下载框",
          "type": "toggle",
          "default": "true",
          "description": "关闭后只在通知栏提示"
        },
        {
          "key": "maxThreads",
          "label": "最大并发",
          "type": "slider",
          "default": "16",
          "min": 1,
          "max": 48,
          "step": 1
        },
        {
          "key": "domain",
          "label": "站点域名",
          "type": "text",
          "default": "",
          "description": "只对该域名生效，留空表示全部"
        }
      ]
    },
    {
      "id": "community.example-filter",
      "name": "示例：下载链接过滤器",
      "version": "1.0.0",
      "author": "你的名字",
      "description": "示例：不含 zip 包，直接指向仓库，安装时由 App 从 GitHub 拉取整包。",
      "category": "工具",
      "icon": "🧪",
      "repo": "your-name/another-plugin",
      "changelog": "1.0.0\n· 首个版本",
      "permissions": ["network"],
      "config": [
        {
          "key": "mode",
          "label": "处理模式",
          "type": "choice",
          "default": "白名单",
          "options": ["白名单", "黑名单"],
          "description": "决定下面的规则列表是放行还是拦截"
        }
      ]
    }
  ]
}
