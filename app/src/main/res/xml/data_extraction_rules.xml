<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="guard.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="quarantine" />
        <exclude domain="external" path="quarantine" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="guard.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="quarantine" />
        <exclude domain="external" path="quarantine" />
    </device-transfer>
</data-extraction-rules>
