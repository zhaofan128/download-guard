{
  "manifest_version": 3,
  "name": "DownloadGuard 下载接管",
  "version": "3.2.0",
  "description": "把浏览器下载交给 DownloadGuard：带 Cookie 与 Referer 投递，网盘直链也能下。",
  "minimum_chrome_version": "102",
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DownloadGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
